# PostgreSQL connection string. Alternatively set SQL_USER, SQL_PASSWORD, SQL_DB_NAME and SQL_HOST.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkly"

# Required in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL, used for the Google OAuth redirect (APP_URL/auth/callback).
APP_URL="http://localhost:3000"

# Optional: Google sign-in. Leave empty to offer email and password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma separated emails that become administrators on sign-up.
# The very first account is always an administrator.
ADMIN_EMAILS=
