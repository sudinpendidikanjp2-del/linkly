datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // arm64 (Apple Silicon, Graviton, Raspberry Pi) next to the build machine's own target.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  links       Link[]
  collections Collection[]
  bioPage     BioPage?
}

model Link {
  id                 String    @id @default(cuid())
  userId             String
  collectionId       String?
  title              String
  originalUrl        String
  slug               String    @unique
  passwordHash       String?
  isEnabled          Boolean   @default(true)
  startsAt           DateTime?
  expiresAt          DateTime?
  landingEnabled     Boolean   @default(false)
  landingDescription String?
  landingImageUrl    String?
  clickCount         Int       @default(0)
  qrScanCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  clicks     Click[]

  @@index([userId, createdAt])
  @@index([collectionId])
}

model Click {
  id          String   @id @default(cuid())
  linkId      String
  timestamp   DateTime @default(now())
  country     String?
  city        String?
  device      String?
  os          String?
  browser     String?
  referrer    String?
  visitorHash String?
  isQrScan    Boolean  @default(false)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([timestamp])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@index([userId])
}

model BioPage {
  userId         String   @id
  handle         String   @unique
  title          String
  bio            String?
  avatarUrl      String?
  theme          String   @default("slate")
  buttonStyle    String   @default("classic")
  showFolders    Boolean  @default(true)
  showBranding   Boolean  @default(true)
  socials        Json     @default("{}")
  /// Appearance overrides, validated by designSchema.
  design         Json     @default("{}")
  /// Ordered content blocks (link, button, image, video, heading, text, divider).
  blocks         Json     @default("[]")
  /// Floating images, shapes and buttons.
  floaters       Json     @default("[]")
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id                  String  @id @default("default")
  registrationEnabled Boolean @default(true)
}
