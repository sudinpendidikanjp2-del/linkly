datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  links       Link[]
  collections Collection[]
  bioPage     BioPage?
}

model Link {
  id                 String    @id @default(cuid())
  userId             String
  collectionId       String?
  title              String
  originalUrl        String
  slug               String    @unique
  passwordHash       String?
  isEnabled          Boolean   @default(true)
  startsAt           DateTime?
  expiresAt          DateTime?
  landingEnabled     Boolean   @default(false)
  landingDescription String?
  landingImageUrl    String?
  clickCount         Int       @default(0)
  qrScanCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  clicks     Click[]
  bioLinks   BioLink[]

  @@index([userId, createdAt])
  @@index([collectionId])
}

model Click {
  id          String   @id @default(cuid())
  linkId      String
  timestamp   DateTime @default(now())
  country     String?
  city        String?
  device      String?
  os          String?
  browser     String?
  referrer    String?
  visitorHash String?
  isQrScan    Boolean  @default(false)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([timestamp])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@index([userId])
}

model BioPage {
  userId      String   @id
  handle      String   @unique
  title       String
  bio         String?
  avatarUrl   String?
  bgImageUrl  String?
  theme       String   @default("slate")
  buttonStyle String   @default("classic")
  videoUrl    String?
  showFolders Boolean  @default(true)
  socials     Json     @default("{}")
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links BioLink[]
}

model BioLink {
  pageId   String
  linkId   String
  position Int

  page BioPage @relation(fields: [pageId], references: [userId], onDelete: Cascade)
  link Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([pageId, linkId])
  @@index([pageId, position])
}

model AppSettings {
  id                  String  @id @default("default")
  registrationEnabled Boolean @default(true)
}
