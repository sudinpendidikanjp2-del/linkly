{
  "id": "/",
  "name": "Linkly",
  "short_name": "Linkly",
  "description": "Pemendek tautan dengan kode QR, statistik klik, dan halaman bio.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f7f5",
  "theme_color": "#f7f7f5",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Tautan baru", "short_name": "Baru", "url": "/links?new=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Semua tautan", "short_name": "Tautan", "url": "/links", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Halaman bio", "short_name": "Bio", "url": "/bio", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/links",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
