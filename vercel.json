{
  "version": 2,
  "framework": "vite",
  "buildCommand": "prisma generate && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/r/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:slug",
      "destination": "/api/index"
    }
  ]
}
