{
  "version": 2,
  "framework": "vite",
  "buildCommand": "prisma generate && prisma migrate deploy && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth/callback", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/b/:handle", "destination": "/api/index" },
    { "source": "/tree/:handle", "destination": "/api/index" },
    { "source": "/lt/:handle", "destination": "/api/index" },
    { "source": "/t/:handle", "destination": "/api/index" },
    { "source": "/r/:slug", "destination": "/api/index" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/links", "destination": "/index.html" },
    { "source": "/links/:id", "destination": "/index.html" },
    { "source": "/collections", "destination": "/index.html" },
    { "source": "/bio", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/:slug/unlock", "destination": "/api/index" },
    { "source": "/:slug", "destination": "/api/index" }
  ]
}
